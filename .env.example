# Kopiera till .env lokalt, eller lägg in samma variabler i Netlify/Vercel.

# Webbplatsens kanoniska adress (används för canonical, hreflang, sitemap, Open Graph).
PUBLIC_SITE_URL=https://www.example.se

# Sätt till true för att blockera indexering (staging). Preview-deploys på
# Netlify och Vercel blockeras automatiskt.
PUBLIC_NOINDEX=false

# Sätt till true för att även bygga exempelprojekt, -nyheter och -annonser
# (filer med example: true). Bra för att förhandsgranska mallarna.
PUBLIC_SHOW_EXAMPLES=false

# ---------------------------------------------------------------------------
# Formulär: netlify | formspree | custom
#   netlify   – Netlify Forms (standard, kräver hosting på Netlify)
#   formspree – sätt endpoint-URL:erna nedan (https://formspree.io/f/xxxxxxx)
#   custom    – valfri endpoint som tar emot multipart/form-data och svarar 2xx
# ---------------------------------------------------------------------------
PUBLIC_FORM_PROVIDER=netlify
PUBLIC_FORM_ENDPOINT_QUOTE=
PUBLIC_FORM_ENDPOINT_FAULT_REPORT=

# ---------------------------------------------------------------------------
# Analys (valfritt). none | plausible | umami
# Standard är none: inga cookies, ingen spårning, ingen cookiebanner.
# ---------------------------------------------------------------------------
PUBLIC_ANALYTICS_PROVIDER=none
# Plausible: domänen som registrerats i Plausible, och ev. egen skript-URL
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Umami: website-id och skript-URL
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=
# true (standard) = visa samtyckesbanner och ladda analys först efter godkännande.
PUBLIC_ANALYTICS_REQUIRE_CONSENT=true

# Verifiering (valfritt) – innehållet i content-attributet från Search Console / Bing.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# Pexels API key for scripts/pexels.mjs (picking stock photos). Only used locally, never in the site.
PEXELS_API_KEY=
