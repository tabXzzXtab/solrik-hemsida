---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDict } from '~/i18n';
import { routeAlternates, type Lang } from '~/i18n/routes';
import { crumbs } from '~/lib/nav';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import QuoteForm from '~/components/forms/QuoteForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.contact;
const trail = crumbs(lang, 'contact');
---

<BaseLayout lang={lang} title={c.seo.title} description={c.seo.description} alternates={routeAlternates('contact')} breadcrumbs={trail} pageType="ContactPage" legalName>
  <div class="container-site pt-8 pb-20 lg:pt-10 lg:pb-32">
    <Breadcrumbs lang={lang} items={trail} />
    <div class="mt-10 max-w-3xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{c.h1}</h1>
      <p class="mt-6 text-lead text-muted">{c.lead}</p>
    </div>

    <!-- The form is the only contact channel. -->
    <section id="offert" aria-labelledby="quote-title" class="mt-16 max-w-4xl scroll-mt-28 lg:mt-24">
      <div class="rounded-[var(--radius-card)] bg-surface p-7 ring-1 ring-line sm:p-10 lg:p-14">
        <h2 id="quote-title" class="text-h2 font-semibold">{c.form.title}</h2>
        <p class="mt-3 text-muted">{c.form.intro}</p>
        <div class="mt-10">
          <QuoteForm lang={lang} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
