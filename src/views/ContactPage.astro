---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PHONE, SERVICE_AREA } from '~/config/company';
import { getDict } from '~/i18n';
import { routeAlternates, routePath, type Lang } from '~/i18n/routes';
import { telHref } from '~/lib/format';
import { crumbs } from '~/lib/nav';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import QuoteForm from '~/components/forms/QuoteForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = t.contact;
const trail = crumbs(lang, 'contact');
const tel = telHref(PHONE);

// Phone and the form below are the only contact channels.
const rows = [
  { label: t.common.phone, value: PHONE, href: tel, big: true },
  { label: t.common.serviceArea, value: SERVICE_AREA[lang], href: null },
];
---

<BaseLayout lang={lang} title={c.seo.title} description={c.seo.description} alternates={routeAlternates('contact')} breadcrumbs={trail} pageType="ContactPage">
  <div class="container-site pt-8 pb-20 lg:pt-10 lg:pb-32">
    <Breadcrumbs lang={lang} items={trail} />
    <div class="mt-10 max-w-3xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{c.h1}</h1>
      <p class="mt-6 text-lead text-muted">{c.lead}</p>
    </div>

    <div class="mt-16 grid gap-16 lg:mt-24 lg:grid-cols-12 lg:gap-20">
      <!-- Details -->
      <div class="lg:col-span-4">
        <h2 class="text-lg font-semibold">{c.detailsTitle}</h2>
        <address class="mt-5 border-b border-line not-italic">
          <dl>
            {
              rows.map((row) => (
                <div class="border-t border-line py-5">
                  <dt class="text-sm text-muted">{row.label}</dt>
                  <dd class:list={['mt-1', row.big ? 'text-2xl font-semibold' : 'font-medium']}>
                    {row.href ? <a href={row.href} class="tap break-words underline-offset-4 hover:underline">{row.value}</a> : row.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </address>

        <p class="mt-10">
          <a href={routePath('faultReport', lang)} class="tap font-semibold text-accent-text underline underline-offset-4">{c.faultLink}</a>
        </p>
      </div>

      <!-- Contact / quote form -->
      <section id="offert" aria-labelledby="quote-title" class="scroll-mt-28 lg:col-span-8">
        <div class="rounded-[var(--radius-card)] bg-surface p-7 ring-1 ring-line sm:p-10 lg:p-14">
          <h2 id="quote-title" class="text-h2 font-semibold">{c.form.title}</h2>
          <p class="mt-3 text-muted">{c.form.intro}</p>
          <div class="mt-10">
            <QuoteForm lang={lang} />
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
