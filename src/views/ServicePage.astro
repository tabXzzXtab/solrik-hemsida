---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SERVICE_IMAGES } from '~/config/images';
import { getDict } from '~/i18n';
import { routePath, serviceAlternates, servicePath, SERVICE_KEYS, type Lang, type ServiceKey } from '~/i18n/routes';
import { crumbs } from '~/lib/nav';
import { faqNode, serviceNode } from '~/lib/schema';
import Button from '~/components/ui/Button.astro';
import PageHero from '~/components/ui/PageHero.astro';
import Section from '~/components/ui/Section.astro';
import SectionHeader from '~/components/ui/SectionHeader.astro';
import AreaGrid from '~/components/blocks/AreaGrid.astro';
import Checklist from '~/components/blocks/Checklist.astro';
import PromiseStrip from '~/components/blocks/PromiseStrip.astro';
import ProcessSteps from '~/components/blocks/ProcessSteps.astro';
import FAQAccordion from '~/components/blocks/FAQAccordion.astro';
import CTABand from '~/components/blocks/CTABand.astro';

interface Props {
  lang: Lang;
  service: ServiceKey;
}

const { lang, service } = Astro.props;
const t = getDict(lang);
const s = t.services.items[service];
const labels = t.services.labels;
const image = SERVICE_IMAGES[service];
const path = servicePath(service, lang);
const site = Astro.site!;
const url = new URL(path, site).href;
const trail = crumbs(lang, 'services', { label: s.name, href: path });
const contactPath = routePath('contact', lang);
const explainer = 'explainer' in s ? s.explainer : undefined;
const areaColumns = s.areas.length % 4 === 0 ? 4 : 3;
const others = SERVICE_KEYS.filter((k) => k !== service);

const schema = [
  serviceNode({
    site,
    url,
    name: s.name,
    description: s.seo.description,
    lang,
    provider: service === 'fastighetsforvaltning' || service === 'fastighetsdrift' ? 'propertyManagement' : 'org',
  }),
  faqNode(url, s.faq),
];
---

<BaseLayout
  lang={lang}
  title={s.seo.title}
  description={s.seo.description}
  alternates={serviceAlternates(service)}
  image={image.src}
  imageAlt={image.alt[lang]}
  breadcrumbs={trail}
  schema={schema}
>
  <PageHero lang={lang} title={s.h1} lead={s.lead} breadcrumbs={trail} image={{ src: image.src, alt: image.alt[lang] }}>
    <Fragment slot="actions">
      <Button href={`${routePath('contact', lang)}#offert`}>{t.cta.primary}</Button>
      <Button href={contactPath} variant="secondary">{t.cta.secondary}</Button>
    </Fragment>
  </PageHero>

  <!-- Intro -->
  <Section flush="top">
    <div class="max-w-2xl space-y-5 text-lead lg:ml-[calc(100%/12*4)]">
      {s.intro.map((p) => <p>{p}</p>)}
    </div>
  </Section>

  <!-- Areas -->
  <Section labelledby="areas-title" flush="top">
    <SectionHeader id="areas-title" title={labels.areas} />
    <AreaGrid items={s.areas} columns={areaColumns} />
  </Section>

  {
    explainer && (
      <Section tone="sunken" labelledby="explainer-title">
        <SectionHeader id="explainer-title" title={explainer.title} intro={explainer.intro} />
        <div class="mt-12 grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line md:grid-cols-2 lg:mt-16">
          {explainer.columns.map((col) => (
            <div class="bg-surface p-8 lg:p-12">
              <h3 class="text-h3 font-semibold">{col.title}</h3>
              <p class="mt-3 text-muted">{col.text}</p>
              <ul class="mt-6 list-disc space-y-2 pl-5 marker:text-line-strong">
                {col.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </Section>
    )
  }

  <!-- Included -->
  <Section labelledby="includes-title">
    <SectionHeader id="includes-title" title={labels.includes} />
    <Checklist items={s.includes} class="mt-12 lg:mt-16" />
  </Section>

  <Section tone="sunken" labelledby="promises-title">
    <PromiseStrip lang={lang} title={labels.promises} headingId="promises-title" />
  </Section>

  <!-- Process -->
  <Section labelledby="process-title">
    <SectionHeader id="process-title" title={labels.process} />
    <ProcessSteps steps={s.process} />
  </Section>

  <!-- FAQ -->
  <Section labelledby="faq-title" flush="top">
    <SectionHeader id="faq-title" title={labels.faq} />
    <div class="mt-10 lg:mt-14 lg:ml-[calc(100%/12*4)]">
      <FAQAccordion items={s.faq} />
    </div>
  </Section>

  <!-- Related services -->
  <Section tone="sunken" spacing="sm" labelledby="related-title">
    <h2 id="related-title" class="text-lg font-semibold">{labels.related}</h2>
    <ul class="mt-6 flex flex-wrap gap-x-10 gap-y-6">
      {
        others.map((key) => (
          <li>
            <a href={servicePath(key, lang)} class="tap text-lg font-medium text-accent-text underline underline-offset-4 decoration-1 hover:decoration-2">
              {t.services.items[key].name}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <CTABand lang={lang} title={s.cta.title} text={s.cta.text} />
</BaseLayout>
