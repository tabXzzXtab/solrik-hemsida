---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { EMERGENCY_PHONE } from '~/config/company';
import { getDict } from '~/i18n';
import { routeAlternates, routePath, type Lang } from '~/i18n/routes';
import { telHref } from '~/lib/format';
import { crumbs } from '~/lib/nav';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import Button from '~/components/ui/Button.astro';
import Section from '~/components/ui/Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const j = t.jour;
const trail = crumbs(lang, 'jour');
// The jour line isn't open yet. Once EMERGENCY_PHONE is set, the page shows the number and a call button.
const tel = telHref(EMERGENCY_PHONE);
const faultHref = routePath('faultReport', lang);
---

<BaseLayout lang={lang} title={j.seo.title} description={j.seo.description} alternates={routeAlternates('jour')} breadcrumbs={trail}>
  <div class="container-site pt-8 pb-16 lg:pt-10 lg:pb-24">
    <Breadcrumbs lang={lang} items={trail} />
    <div class="mt-10 max-w-3xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{j.h1}</h1>
      <p class="mt-6 text-lead text-muted">{j.lead}</p>
    </div>

    <div class="mt-12 max-w-3xl rounded-[var(--radius-card)] bg-danger-soft p-8 lg:mt-16 lg:p-12">
      {
        tel ? (
          <>
            <p class="text-sm text-muted">{j.numberLabel}</p>
            <p class="mt-1 text-3xl font-semibold">
              <a href={tel} class="underline-offset-4 hover:underline">{EMERGENCY_PHONE}</a>
            </p>
            <div class="mt-8">
              <Button href={tel} variant="danger" size="lg">{j.call}</Button>
            </div>
          </>
        ) : (
          <>
            <h2 class="text-h3 font-semibold">{j.pending.title}</h2>
            <p class="mt-3 max-w-xl text-muted">{j.pending.text}</p>
            <div class="mt-8">
              <Button href={faultHref} variant="danger" size="lg">{j.pending.button}</Button>
            </div>
          </>
        )
      }
      <p class="mt-8 border-t border-danger/20 pt-6 font-medium">{j.lifeThreatening}</p>
    </div>
  </div>

  <Section flush="top" labelledby="urgent-title">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <h2 id="urgent-title" class="text-h2 font-semibold">{j.urgent.title}</h2>
        <ul class="mt-6 list-disc space-y-3 pl-5 marker:text-danger">
          {j.urgent.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <div class="rounded-[var(--radius-card)] bg-sunken p-8 lg:p-10">
          <h2 class="text-h3 font-semibold">{j.notUrgent.title}</h2>
          <p class="mt-3 text-muted">{j.notUrgent.text}</p>
          <div class="mt-8">
            <Button href={faultHref}>{j.notUrgent.button}</Button>
          </div>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
