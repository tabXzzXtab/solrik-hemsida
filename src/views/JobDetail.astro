---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDict } from '~/i18n';
import { entryPath, routePath, type Lang } from '~/i18n/routes';
import { entryAlternates, entrySlug } from '~/lib/content';
import { formatDate, mailHref } from '~/lib/format';
import { crumbs } from '~/lib/nav';
import { jobPostingNode } from '~/lib/schema';
import Button from '~/components/ui/Button.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ExampleNotice from '~/components/blocks/ExampleNotice.astro';
import FactsBox from '~/components/blocks/FactsBox.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'jobs'>;
}

const { lang, entry } = Astro.props;
const t = getDict(lang);
const c = t.careers;
const { data } = entry;
const { Content } = await render(entry);
const site = Astro.site!;
const path = entryPath('jobs', entrySlug(entry), lang);
const url = new URL(path, site).href;
const trail = crumbs(lang, 'careers', { label: data.title, href: path });
// Applications go to the contact form unless the posting names its own e-mail address.
const mail = data.contactEmail ? mailHref(data.contactEmail, data.title) : null;
const schema = data.example
  ? []
  : [jobPostingNode({ site, url, title: data.title, description: data.description, lang, published: data.published, deadline: data.deadline, location: data.location, extent: data.extent })];
---

<BaseLayout
  lang={lang}
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  alternates={await entryAlternates('jobs', entry)}
  noindex={data.example}
  breadcrumbs={trail}
  schema={schema}
>
  {data.example && <ExampleNotice lang={lang} />}

  <article class="container-site pt-8 pb-20 lg:pt-10 lg:pb-32">
    <Breadcrumbs lang={lang} items={trail} />
    <header class="mt-10 max-w-4xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{data.title}</h1>
      <p class="mt-6 text-lead text-muted">{data.description}</p>
    </header>

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-20">
      <div class="prose lg:col-span-7">
        <Content />
      </div>
      <div class="space-y-8 lg:col-span-5">
        <FactsBox
          title={c.positions.title}
          facts={[
            { label: c.positions.location, value: data.location },
            { label: c.positions.extent, value: data.extent },
            { label: t.common.published, value: formatDate(data.published, lang) },
            { label: c.positions.deadline, value: data.deadline ? formatDate(data.deadline, lang) : undefined },
          ]}
        />
        <div class="rounded-[var(--radius-card)] bg-accent-soft p-8 lg:p-10">
          <h2 class="text-h3 font-semibold">{c.job.applyTitle}</h2>
          <p class="mt-2 text-muted">{c.job.applyText}</p>
          {data.contactName && <p class="mt-5">{t.common.contactPerson}: <strong>{data.contactName}</strong></p>}
          {mail && <p class="mt-1 break-all">{data.contactEmail}</p>}
          <div class="mt-8">
            {mail ? <Button href={mail}>{c.job.applyButton}</Button> : <Button href={`${routePath('contact', lang)}#offert`}>{c.job.applyFormButton}</Button>}
          </div>
        </div>
      </div>
    </div>

    <p class="mt-16">
      <a href={`${routePath('careers', lang)}#positions`} class="tap font-semibold text-accent-text underline underline-offset-4">{c.job.back}</a>
    </p>
  </article>
</BaseLayout>
