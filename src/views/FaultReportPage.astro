---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PHONE, SHOW_TENANTS_PAGE } from '~/config/company';
import { getDict } from '~/i18n';
import { routeAlternates, routePath, type Lang } from '~/i18n/routes';
import { telHref } from '~/lib/format';
import { crumbs } from '~/lib/nav';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import EmergencyNotice from '~/components/blocks/EmergencyNotice.astro';
import FaultReportForm from '~/components/forms/FaultReportForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const f = t.faultReport;
const trail = SHOW_TENANTS_PAGE ? crumbs(lang, 'tenants', 'faultReport') : crumbs(lang, 'faultReport');
const tel = telHref(PHONE);
---

<BaseLayout lang={lang} title={f.seo.title} description={f.seo.description} alternates={routeAlternates('faultReport')} breadcrumbs={trail}>
  <div class="container-site pt-8 pb-20 lg:pt-10 lg:pb-32">
    <Breadcrumbs lang={lang} items={trail} />
    <div class="mt-10 max-w-3xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{f.h1}</h1>
      <p class="mt-6 text-lead text-muted">{f.lead}</p>
    </div>

    <EmergencyNotice text={f.emergency} callLabel={f.call} class="mt-10 lg:mt-12" />

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <FaultReportForm lang={lang} />
      </div>
      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="aside-title">
        <div class="rounded-[var(--radius-card)] bg-sunken p-8 lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:p-10">
          <h2 id="aside-title" class="text-h3 font-semibold">{f.asideTitle}</h2>
          <ul class="mt-5 list-disc space-y-3 pl-5 marker:text-line-strong">
            {f.aside.map((item) => <li>{item}</li>)}
          </ul>
          <div class="mt-8 border-t border-line pt-6 text-base">
            <p class="text-muted">{t.common.phone}</p>
            {tel ? <a href={tel} class="tap text-xl font-semibold underline-offset-4 hover:underline">{PHONE}</a> : <p class="text-xl font-semibold">{PHONE}</p>}
            {SHOW_TENANTS_PAGE && (
              <p class="mt-5">
                <a href={routePath('tenants', lang)} class="tap font-medium text-accent-text underline underline-offset-4">{t.nav.tenants}</a>
              </p>
            )}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
