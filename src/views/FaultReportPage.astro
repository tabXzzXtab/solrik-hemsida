---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SHOW_TENANTS_PAGE } from '~/config/company';
import { getDict } from '~/i18n';
import { routeAlternates, routePath, type Lang } from '~/i18n/routes';
import { crumbs } from '~/lib/nav';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import EmergencyNotice from '~/components/blocks/EmergencyNotice.astro';
import FaultReportForm from '~/components/forms/FaultReportForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const f = t.faultReport;
const trail = SHOW_TENANTS_PAGE ? crumbs(lang, 'tenants', 'faultReport') : crumbs(lang, 'faultReport');
---

<BaseLayout lang={lang} title={f.seo.title} description={f.seo.description} alternates={routeAlternates('faultReport')} breadcrumbs={trail} legalName>
  <div class="container-site pt-8 pb-20 lg:pt-10 lg:pb-32">
    <Breadcrumbs lang={lang} items={trail} />
    <div class="mt-10 max-w-3xl lg:mt-16">
      <h1 class="text-h1 font-semibold tracking-[-0.02em]">{f.h1}</h1>
      <p class="mt-6 text-lead text-muted">{f.lead}</p>
    </div>

    <EmergencyNotice text={f.emergency} actionLabel={f.call} href={routePath('jour', lang)} class="mt-10 lg:mt-12" />

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-7">
        <FaultReportForm lang={lang} />
      </div>
      <aside class="lg:col-span-4 lg:col-start-9" aria-labelledby="aside-title">
        <div class="rounded-[var(--radius-card)] bg-sunken p-8 lg:sticky lg:top-[calc(var(--header-h)+2rem)] lg:p-10">
          <h2 id="aside-title" class="text-h3 font-semibold">{f.asideTitle}</h2>
          <!-- Which channel to use: felanmälan for customers, the jour for anything urgent -->
          <dl class="mt-5 space-y-4">
            <div>
              <dt class="font-semibold">{f.channels.faultReport.term}</dt>
              <dd class="mt-1 text-muted">{f.channels.faultReport.text}</dd>
            </div>
            <div>
              <dt class="font-semibold text-danger">{f.channels.jour.term}</dt>
              <dd class="mt-1 text-muted">
                {f.channels.jour.text}{' '}
                <a href={routePath('jour', lang)} class="font-semibold text-danger underline underline-offset-4">{f.channels.jour.link}</a>
              </dd>
            </div>
          </dl>
          <ul class="mt-6 list-disc space-y-3 border-t border-line pt-6 pl-5 marker:text-line-strong">
            {f.aside.map((item) => <li>{item}</li>)}
          </ul>
          {SHOW_TENANTS_PAGE && (
              <p class="mt-8">
                <a href={routePath('tenants', lang)} class="tap font-medium text-accent-text underline underline-offset-4">{t.nav.tenants}</a>
              </p>
            )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
