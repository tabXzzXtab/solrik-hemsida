---
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getDict } from '~/i18n';
import { entryPath, routePath, type Lang } from '~/i18n/routes';
import { entryAlternates, entrySlug, getProjects } from '~/lib/content';
import { crumbs } from '~/lib/nav';
import { projectNode } from '~/lib/schema';
import Figure from '~/components/ui/Figure.astro';
import Section from '~/components/ui/Section.astro';
import Breadcrumbs from '~/components/layout/Breadcrumbs.astro';
import ExampleNotice from '~/components/blocks/ExampleNotice.astro';
import FactsBox from '~/components/blocks/FactsBox.astro';
import Gallery from '~/components/blocks/Gallery.astro';
import ProjectCard from '~/components/blocks/ProjectCard.astro';
import CTABand from '~/components/blocks/CTABand.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const t = getDict(lang);
const p = t.projects;
const { data } = entry;
const { Content } = await render(entry);
const site = Astro.site!;
const path = entryPath('projects', entrySlug(entry), lang);
const url = new URL(path, site).href;
const trail = crumbs(lang, 'projects', { label: data.title, href: path });
const [cover, ...rest] = data.images;

const all = await getProjects(lang);
const others = all.filter((e) => e.id !== entry.id);
const related = [...others.filter((e) => e.data.category === data.category), ...others.filter((e) => e.data.category !== data.category)].slice(0, 3);

const imageUrls = await Promise.all(
  data.images.map(async (img) => new URL((await getImage({ src: img.src, width: 1200, format: 'jpg' })).src, site).href),
);
const schema = data.example ? [] : [projectNode({ site, url, name: data.title, description: data.description, lang, imageUrls, year: data.year })];
---

<BaseLayout
  lang={lang}
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  alternates={await entryAlternates('projects', entry)}
  image={cover.src}
  imageAlt={cover.alt}
  noindex={data.example}
  ogType="article"
  breadcrumbs={trail}
  schema={schema}
>
  {data.example && <ExampleNotice lang={lang} />}

  <article>
    <header class="container-site pt-8 lg:pt-10">
      <Breadcrumbs lang={lang} items={trail} />
      <div class="mt-10 grid gap-8 lg:mt-16 lg:grid-cols-12 lg:items-end lg:gap-16">
        <div class="lg:col-span-7">
          <p class="text-muted">{p.categories[data.category]} · {data.year}</p>
          <h1 class="mt-3 text-h1 font-semibold tracking-[-0.02em]">{data.title}</h1>
        </div>
        <p class="text-lead text-muted lg:col-span-5">{data.description}</p>
      </div>
      <Figure
        src={cover.src}
        alt={cover.alt}
        priority
        aspect="aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9]"
        sizes="(min-width: 86rem) 79rem, 100vw"
        widths={[640, 960, 1280, 1680]}
        class="mt-12 lg:mt-16"
      />
    </header>

    <Section>
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="prose lg:col-span-7">
          <Content />
        </div>
        <div class="lg:col-span-5">
          <FactsBox
            title={p.facts.title}
            class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]"
            facts={[
              { label: p.facts.location, value: data.location },
              { label: p.facts.client, value: data.client },
              { label: p.facts.contractType, value: data.contractType },
              { label: p.facts.year, value: data.year },
              { label: p.facts.scope, value: data.scope },
              { label: p.facts.category, value: p.categories[data.category] },
            ]}
          />
        </div>
      </div>
    </Section>

    {
      rest.length > 0 && (
        <Section labelledby="gallery-title" flush="top">
          <h2 id="gallery-title" class="text-h2 font-semibold">{p.gallery}</h2>
          <Gallery images={rest} />
        </Section>
      )
    }
  </article>

  {
    related.length > 0 && (
      <Section tone="sunken" labelledby="related-title">
        <div class="flex items-end justify-between gap-6">
          <h2 id="related-title" class="text-h2 font-semibold">{p.related}</h2>
          <a href={routePath('projects', lang)} class="tap font-semibold text-accent-text underline underline-offset-4">{p.back}</a>
        </div>
        <ul class="mt-12 grid gap-x-10 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
          {related.map((e) => (
            <li>
              <ProjectCard lang={lang} entry={e} />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <CTABand lang={lang} />
</BaseLayout>
