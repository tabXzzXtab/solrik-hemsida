---
import '~/styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { COMPANY_SHORT_NAME } from '~/config/company';
import { IMAGES } from '~/config/images';
import logo from '~/assets/logo/solrik-logo.png';
import { ANALYTICS_ENABLED, NOINDEX, VERIFICATION } from '~/config/site';
import { getDict } from '~/i18n';
import { LANGS, type Lang } from '~/i18n/routes';
import { breadcrumbNode, siteNodes, webPageNode } from '~/lib/schema';
import type { Crumb } from '~/components/layout/Breadcrumbs.astro';
import Header from '~/components/layout/Header.astro';
import Footer from '~/components/layout/Footer.astro';
import MobileActionBar from '~/components/layout/MobileActionBar.astro';
import ConsentBanner from '~/components/layout/ConsentBanner.astro';

interface Props {
  lang: Lang;
  /** Page title without the brand; " | {COMPANY_SHORT_NAME}" is appended unless already present. */
  title: string;
  description: string;
  /** Paths of this page in each language (for hreflang and the language switcher). */
  alternates?: Partial<Record<Lang, string>>;
  /** Source for the Open Graph image (cropped to 1200×630). Defaults to the hero image. */
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Same crumbs as the visible breadcrumb; generates BreadcrumbList. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
  /** WebPage subtype, e.g. "AboutPage", "ContactPage", "CollectionPage". */
  pageType?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  lang,
  title,
  description,
  alternates = {},
  image,
  imageAlt,
  noindex = false,
  ogType = 'website',
  breadcrumbs = [],
  schema = [],
  pageType,
  publishedTime,
  modifiedTime,
} = Astro.props;

const t = getDict(lang);
const site = Astro.site ?? new URL('https://www.example.se');
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).href;

const fullTitle = title.includes(COMPANY_SHORT_NAME) ? title : `${title} | ${COMPANY_SHORT_NAME}`;
const robots = NOINDEX ? 'noindex, nofollow' : noindex ? 'noindex, follow' : null;

const ogSource = image ?? IMAGES.hero.src;
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogImageUrl = new URL(og.src, site).href;
// The organisation always uses the hero image (same transform → same cached file).
const orgImage = image ? await getImage({ src: IMAGES.hero.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : og;
const orgImageUrl = new URL(orgImage.src, site).href;
// public/logo.png is the same file as the header logo (scripts/brand-assets.mjs).
const logoNode = { url: new URL('/logo.png', site).href, width: logo.width, height: logo.height };

const hreflangs = LANGS.filter((l) => alternates[l]).map((l) => ({ lang: l, href: new URL(alternates[l]!, site).href }));
const xDefault = alternates.sv ? new URL(alternates.sv, site).href : null;

const graph = [
  ...siteNodes(site, lang, logoNode, orgImageUrl),
  webPageNode({ site, url: canonical, name: fullTitle, description, lang, imageUrl: ogImageUrl, hasBreadcrumb: breadcrumbs.length > 0, type: pageType }),
  ...(breadcrumbs.length ? [breadcrumbNode(canonical, site, breadcrumbs)] : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {xDefault && hreflangs.length > 1 && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-inter-tight" preload />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={COMPANY_SHORT_NAME} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {LANGS.filter((l) => l !== lang && alternates[l]).map((l) => <meta property="og:locale:alternate" content={getDict(l).meta.ogLocale} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? IMAGES.hero.alt[lang]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfbf8" />
    <meta name="color-scheme" content="light" />
    <link rel="sitemap" href="/sitemap.xml" />
    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas pb-[calc(4rem+env(safe-area-inset-bottom))] [@media(max-height:30rem)]:pb-[calc(3rem+env(safe-area-inset-bottom))] text-ink antialiased lg:pb-0">
    <a
      href="#main"
      class="sr-only z-[60] bg-accent px-4 py-3 font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.meta.skipToContent}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileActionBar lang={lang} />
    {ANALYTICS_ENABLED && <ConsentBanner lang={lang} />}
  </body>
</html>
