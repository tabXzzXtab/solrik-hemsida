---
/** News list row: the date first, then title and summary. */
import type { CollectionEntry } from 'astro:content';
import { entryPath, type Lang } from '~/i18n/routes';
import { entrySlug } from '~/lib/content';
import { formatDate, isoDate } from '~/lib/format';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'news'>;
  headingLevel?: 2 | 3;
}

const { lang, entry, headingLevel = 3 } = Astro.props;
const { data } = entry;
const href = entryPath('news', entrySlug(entry), lang);
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="group relative grid gap-2 border-t border-line py-8 sm:grid-cols-[11rem_1fr] sm:gap-10 lg:py-10">
  <time datetime={isoDate(data.date)} class="font-medium text-ink sm:pt-1">{formatDate(data.date, lang)}</time>
  <div>
    <H class="text-xl font-semibold lg:text-2xl">
      <a href={href} class="card-link underline-offset-4 group-hover:underline">{data.title}</a>
    </H>
    <p class="mt-2 max-w-2xl text-muted">{data.description}</p>
  </div>
</article>
