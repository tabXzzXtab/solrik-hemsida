---
/**
 * Category + year filter for the project grid. Hidden until JS runs, so
 * visitors without JS simply see every project.
 */
import { getDict } from '~/i18n';
import { PROJECT_CATEGORIES, type Lang } from '~/i18n/routes';

interface Props {
  lang: Lang;
  years: number[];
  total: number;
}

const { lang, years, total } = Astro.props;
const t = getDict(lang);
const tab =
  'inline-flex min-h-11 min-w-11 items-center justify-center px-3 font-medium text-muted underline-offset-[10px] decoration-2 hover:text-ink aria-pressed:text-ink aria-pressed:underline';
---

<div data-project-filter hidden class="flex flex-col gap-8 border-b border-line pb-8 lg:flex-row lg:items-end lg:justify-between">
  <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:gap-12">
    <fieldset>
      <legend class="mb-2 text-sm text-muted">{t.projects.filter.category}</legend>
      <div class="-mx-3 flex flex-wrap gap-x-2">
        <button type="button" class={tab} data-category-filter="all" aria-pressed="true">{t.projects.filter.all}</button>
        {
          PROJECT_CATEGORIES.map((category) => (
            <button type="button" class={tab} data-category-filter={category} aria-pressed="false">
              {t.projects.categories[category]}
            </button>
          ))
        }
      </div>
    </fieldset>
    <div>
      <label for="project-year" class="mb-2 block text-sm text-muted">{t.projects.filter.year}</label>
      <select id="project-year" data-year-filter class="min-h-11 rounded-lg border-[1.5px] border-line-strong bg-surface py-2 pr-10 pl-3 font-medium">
        <option value="all">{t.projects.filter.allYears}</option>
        {years.map((y) => <option value={String(y)}>{y}</option>)}
      </select>
    </div>
  </div>
  <p class="text-sm text-muted" aria-live="polite" data-filter-count data-template={t.projects.filter.results}>
    {t.projects.filter.results.replace('{count}', String(total))}
  </p>
</div>

<script>
  import '~/scripts/project-filter';
</script>
