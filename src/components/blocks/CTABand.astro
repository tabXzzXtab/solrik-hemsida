---
/** Closing band on most pages: felanmälan for existing customers, the jour for urgent problems. */
import type { Lang } from '~/i18n/routes';
import { routePath } from '~/i18n/routes';
import { getDict } from '~/i18n';
import Button from '~/components/ui/Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
// One CTA band per page, so a fixed id is safe.
const headingId = 'cta-band-heading';
---

<section aria-labelledby={headingId} class="py-20 lg:py-32">
  <div class="container-site">
    <div class="grid gap-10 rounded-[var(--radius-card)] bg-accent-soft px-8 py-14 sm:px-12 lg:px-16 lg:py-20 xl:grid-cols-12 xl:items-end">
      <div class="xl:col-span-7">
        <h2 id={headingId} class="text-h2 font-semibold">{t.cta.title}</h2>
        <p class="mt-4 max-w-xl text-lead text-muted">{t.cta.text}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row xl:col-span-5 xl:justify-end [&>a]:whitespace-nowrap">
        <Button href={routePath('faultReport', lang)} variant="primary" size="lg">{t.nav.faultReport}</Button>
        <Button href={routePath('jour', lang)} variant="danger" size="lg">{t.nav.jour}</Button>
      </div>
    </div>
  </div>
</section>
