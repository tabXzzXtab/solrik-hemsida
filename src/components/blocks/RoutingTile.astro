---
/** "Vill du bygga?"-style visitor routing tile. The whole tile is the link's hit area. */
interface Props {
  question: string;
  text: string;
  link: string;
  href: string;
}

const { question, text, link, href } = Astro.props;
---

<article class="group relative flex h-full flex-col bg-surface p-8 transition-colors hover:bg-accent-soft lg:p-10">
  <h3 class="text-h3 font-semibold">{question}</h3>
  <p class="mt-3 text-muted">{text}</p>
  <a href={href} class="card-link mt-auto pt-10 font-semibold text-accent-text underline-offset-4 group-hover:underline">{link}</a>
</article>
