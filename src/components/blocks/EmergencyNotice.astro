---
/** "Akuta fel – ring oss" notice with a large tap-to-call number. */
import { PHONE } from '~/config/company';
import { telHref } from '~/lib/format';

interface Props {
  title?: string;
  text: string;
  callLabel: string;
  class?: string;
}

const { title, text, callLabel, class: className } = Astro.props;
const tel = telHref(PHONE);
---

<div role="note" class:list={['flex flex-col gap-5 rounded-[var(--radius-card)] bg-danger-soft p-6 sm:flex-row sm:items-center sm:justify-between lg:px-8 lg:py-7', className]}>
  <div class="max-w-2xl">
    {title && <p class="text-lg font-semibold">{title}</p>}
    <p class:list={[title ? 'mt-1 text-muted' : 'font-medium']}>
      {text}{' '}<strong class="whitespace-nowrap text-ink">{PHONE}</strong>
    </p>
  </div>
  {
    tel && (
      <a href={tel} class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg bg-danger px-6 font-semibold text-canvas hover:opacity-90">
        {callLabel}
      </a>
    )
  }
</div>
