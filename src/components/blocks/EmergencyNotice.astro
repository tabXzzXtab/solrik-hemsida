---
/** "Akuta fel" notice with one action (the fault report form). */
interface Props {
  title?: string;
  text: string;
  actionLabel: string;
  href: string;
  class?: string;
}

const { title, text, actionLabel, href, class: className } = Astro.props;
---

<div role="note" class:list={['flex flex-col gap-5 rounded-[var(--radius-card)] bg-danger-soft p-6 sm:flex-row sm:items-center sm:justify-between lg:px-8 lg:py-7', className]}>
  <div class="max-w-2xl">
    {title && <p class="text-lg font-semibold">{title}</p>}
    <p class:list={[title ? 'mt-1 text-muted' : 'font-medium']}>{text}</p>
  </div>
  <a href={href} class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-lg bg-danger px-6 font-semibold text-canvas hover:opacity-90">
    {actionLabel}
  </a>
</div>
