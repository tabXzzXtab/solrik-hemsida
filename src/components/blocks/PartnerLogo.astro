---
/**
 * A partner logo straight on the page background. Sized by area rather than height,
 * so a wide wordmark and a square symbol carry about the same visual weight.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Target area in px² at full size; scaled by --logo-scale (set on a parent) on small screens. */
  area: number;
  class?: string;
}

const { src, alt, area, class: className } = Astro.props;
const ratio = src.width / src.height;
const height = Math.round(Math.sqrt(area / ratio));
const width = Math.round(height * ratio);
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  densities={[1.5, 2]}
  style={`height: calc(${height}px * var(--logo-scale, 1)); width: auto;`}
  class:list={['max-w-full object-contain', className]}
/>
