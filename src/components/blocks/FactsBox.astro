---
interface Props {
  title: string;
  facts: Array<{ label: string; value?: string | number | null }>;
  class?: string;
}

const { title, facts, class: className } = Astro.props;
const rows = facts.filter((f) => f.value !== undefined && f.value !== null && f.value !== '');
---

<aside class:list={['rounded-[var(--radius-card)] bg-sunken p-8 lg:p-10', className]} aria-labelledby="facts-title">
  <h2 id="facts-title" class="text-lg font-semibold">{title}</h2>
  <dl class="mt-5">
    {
      rows.map((f) => (
        <div class="grid grid-cols-[minmax(7rem,40%)_1fr] gap-4 border-t border-line py-4">
          <dt class="text-muted">{f.label}</dt>
          <dd class="font-medium">{f.value}</dd>
        </div>
      ))
    }
  </dl>
</aside>
