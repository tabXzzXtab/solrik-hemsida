---
/** Ordered process: step number, title and one line of text per row. */
interface Props {
  steps: Array<{ title: string; text: string }>;
}

const { steps } = Astro.props;
---

<ol class="mt-12 border-b border-line lg:mt-16">
  {
    steps.map((step, i) => (
      <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 gap-y-1 border-t border-line py-8 lg:grid-cols-12 lg:gap-x-10 lg:py-10">
        <span class="text-lg text-muted tabular-nums lg:col-span-1">{i + 1}</span>
        <h3 class="text-h3 font-semibold lg:col-span-4">{step.title}</h3>
        <p class="col-start-2 text-muted lg:col-span-7 lg:col-start-auto">{step.text}</p>
      </li>
    ))
  }
</ol>
