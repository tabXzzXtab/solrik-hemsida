---
import { getDict } from '~/i18n';
import type { Lang } from '~/i18n/routes';

interface Props {
  lang: Lang;
  id: string;
  name: string;
  legend: string;
  options: Array<{ value: string; label: string }>;
}

const { lang, id, name, legend, options } = Astro.props;
const t = getDict(lang);
---

<fieldset id={id}>
  <legend class="font-semibold">
    {legend}{' '}<span class="text-sm font-normal text-muted">({t.forms.optional})</span>
  </legend>
  <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:gap-6">
    {
      options.map((o, i) => (
        <label class="flex min-h-11 cursor-pointer items-center gap-3">
          <input type="radio" name={name} value={o.value} id={`${id}-${i}`} class="size-5 cursor-pointer accent-[var(--c-accent)]" />
          {o.label}
        </label>
      ))
    }
  </div>
</fieldset>
