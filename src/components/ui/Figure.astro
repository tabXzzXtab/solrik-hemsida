---
/**
 * Responsive image (AVIF/WebP + srcset) with an optional caption underneath.
 * The LCP image of a page gets `priority`.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  /** Tailwind aspect-ratio class for the frame, e.g. "aspect-[4/3]". */
  aspect?: string;
  class?: string;
  imgClass?: string;
  /** Rounded frame (default). Turn off when the parent card already clips the corners. */
  rounded?: boolean;
}

const {
  src,
  alt,
  caption,
  sizes = '(min-width: 64rem) 50vw, 100vw',
  widths = [480, 768, 1080, 1440],
  priority = false,
  aspect = 'aspect-[4/3]',
  class: className,
  imgClass,
  rounded = true,
} = Astro.props;

const usableWidths = widths.filter((w) => w <= src.width);
if (!usableWidths.includes(src.width) && src.width < Math.max(...widths)) usableWidths.push(src.width);
---

<figure class:list={['relative', className]}>
  <div class:list={['relative overflow-hidden bg-sunken', rounded && 'rounded-[var(--radius-card)]', aspect]}>
    <Picture
      src={src}
      alt={alt}
      widths={usableWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      priority={priority}
      class:list={['h-full w-full object-cover', imgClass]}
    />
  </div>
  {
    caption && <figcaption class="mt-2.5 text-sm text-muted">{caption}</figcaption>
  }
</figure>
